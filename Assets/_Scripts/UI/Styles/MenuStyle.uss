.screen {
    position: absolute;
    width: 100%;
    height: 100%;
}

.menu-panel {
    align-items: center;
    justify-content: space-between;
    align-self: center;
    width: 40%;
    height: 60%;
    background-color: rgba(170, 170, 170, 0.59);
    border-radius: 40px;
}

.menu-button {
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
    margin: 20px;
    font-size: 80px;
    border-radius: 20px;
    border-width: 14px;
    border-color: rgb(239, 204, 64);
    background-color: rgb(209, 154, 47);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.menu-back-button {
    position: absolute;
    left: 50px;
    top: 40px;
    width: 100px;
    height: 100px;
    border-width: 14px;
    border-radius: 100px;
    border-color: rgb(239, 204, 64);
    background-color: rgb(209, 154, 47);
    font-size: 60px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

Button:hover {
    scale: 1.05 1.05;
    transition-property: scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out-bounce;
}

.title-label {
    color: rgb(248, 220, 70);
    -unity-text-outline-color: rgb(209, 154, 47);
    -unity-text-outline-width: 6px;
    text-shadow: 8px 8px 0 rgb(0, 0, 0);
    font-size: 120px;
    -unity-text-align: middle-center;
    letter-spacing: 16px;
    word-spacing: 32px;
}

.h1-label {
    font-size: 80px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-font-style: bold;
    text-shadow: 4px 4px 0 rgb(0, 0, 0);
}

.tool-tip-labe {
    font-size: 60px;
    color: rgb(170, 170, 170);
    -unity-text-align: middle-center;
    text-overflow: ellipsis;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(102, 102, 102);
    -unity-font-style: bold;
}

.menu-field {
    flex-direction: column;
    align-self: stretch;
    margin-top: 0;
    margin-right: 20px;
    margin-bottom: 20px;
    margin-left: 20px;
    font-size: 40px;
    -unity-font-style: bold;
}

.menu-field Label {
    color: rgb(255, 255, 255);
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 1px;
    -unity-text-align: lower-left;
}

.menu-field #unity-text-input {
    border-radius: 20px;
    padding: 16px;
}

.menu-card {
    align-items: center;
    justify-content: center;
    width: 440px;
    height: 750px;
    margin: 20px;
    padding: 40px;
    border-radius: 40px;
    background-color: rgba(170, 170, 170, 0.59);
}
