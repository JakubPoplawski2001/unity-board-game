.card {
    align-items: center;
    justify-content: center;
    width: 440px;
    height: 750px;
    margin: 20px;
    padding: 40px;
    border-radius: 40px;
    background-color: rgb(170, 170, 170);
    border-width: 4px;
    border-color: rgb(0, 0, 0);
    overflow: hidden;
}

.card:hover {
    scale: 1.5 1.5;
    translate: 0 20px;
    transition-duration: 0.4s;
    transition-timing-function: ease-in-out-back;
}

.card-focused {
    scale: 1.5 1.5;
    translate: 0 20px;
    transition-duration: 0.4s;
    transition-timing-function: ease-in-out-back;
}

.card-selection-fx {
    position: absolute;
    width: 100%;
    height: 100%;
    margin: -20px;
    background-color: rgba(209, 154, 47, 0.63);
}

.card-content {
    position: absolute;
    width: 80%;
    height: 80%;
}

.card-label {
    font-size: 50px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-font-style: bold;
    text-shadow: 4px 4px 0 rgb(0, 0, 0);
}
